{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "earnfi",
  "title": "EarnFi",
  "description": "Hire humans and agents, fund real-world work via x402, manage escrow, and retrieve verifiable receipts — Work + Money for Hermes.",
  "version": "1.4.7",
  "author": {
    "name": "EarnFi",
    "email": "hello@earnfi.fun"
  },
  "homepage": "https://earnfi.fun",
  "repository": "https://github.com/earnfidotfun/earnfi-hermes-plugin",
  "license": "MIT",
  "logo": "assets/logo.png",
  "keywords": [
    "earnfi",
    "mcp",
    "work-and-money",
    "human-in-the-loop",
    "marketplace",
    "escrow",
    "x402",
    "payments",
    "receipts",
    "solana"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "earnfi-api": {
          "trust": "untrusted",
          "cost_unit": "USDC",
          "spend_limit": 0
        }
      }
    }
  }
}
